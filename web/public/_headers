/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' blob: data:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/model/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/samples/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/tessdata/*
  Cache-Control: public, max-age=604800
/tesseract/*
  Cache-Control: public, max-age=604800
